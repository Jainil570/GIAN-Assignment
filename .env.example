# PostgreSQL + pgvector. Local default (docker, see README) or the shared hosted database.
DATABASE_URL=postgresql://gian:gian_local_dev@localhost:5433/gian_kb

# Read-only role created by `python -m gian_kb.db --create-reader` (for sharing with evaluators)
READER_USER=gian_reader
READER_PASSWORD=change-me

# Ollama (embeddings + default answer model)
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=bge-m3

# Answer generation: local model served by Ollama
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
